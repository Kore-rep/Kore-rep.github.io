// Glyph footprint in the 80x80 link box, masked out of the cracks so they never
// show through the icon's transparent cutouts.
const holes = {
  linkedin: { x: 22.5, y: 22.5, width: 35, height: 35 },
  github: { x: 22.5, y: 22.5, width: 35, height: 35 },
  email: { x: 20, y: 25, width: 40, height: 30 },
};

const { href, icon, label } = Astro.props;
const { viewBox, d } = icons[icon];
const hole = holes[icon];
const maskId = `crack-mask-${icon}`;
const external = href.startsWith("http");
---

<a
  class="link"
  href={href}
  aria-label={label}
  {...(external && { target: "_blank", rel: "noopener noreferrer" })}
>
  <svg class="crack" viewBox="0 0 80 80" aria-hidden="true">
    <mask id={maskId}>
      <rect width="80" height="80" fill="white"></rect>
      <rect {...hole} rx="3.75" fill="black"></rect>
    </mask>
    <g mask={`url(#${maskId})`}>
      <g class="crack-lines">
        <path pathLength="1" d="M40 40 L47 36 L55 38 L63 31 L72 30"></path>
        <path pathLength="1" d="M55 38 L59 45"></path>
        <path pathLength="1" d="M40 40 L44 47 L42 55 L48 62 L46 72"></path>
        <path pathLength="1" d="M42 55 L35 60"></path>
        <path pathLength="1" d="M40 40 L33 44 L25 42 L18 48 L9 47"></path>
        <path pathLength="1" d="M25 42 L22 35"></path>
        <path pathLength="1" d="M40 40 L36 33 L38 25 L32 18 L34 9"></path>
        <path pathLength="1" d="M40 40 L46 44 L54 51 L61 52 L66 60"></path>
        <path pathLength="1" d="M40 40 L34 36 L27 31 L20 30"></path>
      </g>
    </g>
  </svg>
  <svg class="icon" viewBox={viewBox} fill="currentColor" aria-hidden="true">
    <path d={d} />
  </svg>
</a>

<style>
  .link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    color: inherit;
    border-radius: 50%;
  }

  .link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .icon {
    position: relative;
    width: 40px;
    height: 40px;
    transform-origin: 50% 100%;
    /* Falling back down: accelerate like gravity. */
    transition:
      translate 180ms cubic-bezier(0.55, 0, 1, 0.45),
      filter 180ms ease-in;
  }

  /* Lift on hover (real pointers only, so taps don't leave it stuck up) and on keyboard focus. */
  @media (hover: hover) {
    .link:hover .icon {
      translate: 0 -6px;
      filter: drop-shadow(0 8px 4px rgb(0 0 0 / 0.25));
      transition:
        translate 220ms cubic-bezier(0.2, 0.8, 0.3, 1),
        filter 220ms ease-out;
    }
  }

  .link:focus-visible .icon {
    translate: 0 -6px;
    filter: drop-shadow(0 8px 4px rgb(0 0 0 / 0.25));
  }

  /* Ground cracks, drawn behind the icon when it lands. */
  .crack {
    position: absolute;
    inset: 0;
    fill: none;
    stroke: rgb(0 0 0 / 0.5);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  .crack-lines {
    transform-origin: 40px 40px;
  }

  .crack path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .link.landing .icon {
    animation: impact 260ms 170ms ease-out;
  }

  .link.landing .crack path {
    animation: crack 1100ms 170ms ease-out both;
  }

  @keyframes impact {
    30% {
      scale: 1.08 0.9;
    }
    65% {
      scale: 0.97 1.03;
    }
  }

  @keyframes crack {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    18% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    55% {
      stroke-dashoffset: 0;
      opacity: 0.8;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
</style>

<script>
  // Play the landing (impact + cracks) when a lifted icon is released.
  for (const link of document.querySelectorAll<HTMLAnchorElement>(".link")) {
    const crack = link.querySelector<SVGGElement>(".crack-lines")!;
    let keyboardFocus = false;

    const land = () => {
      crack.style.rotate = `${Math.floor(Math.random() * 360)}deg`;
      link.classList.remove("landing");
      void link.offsetWidth; // restart the animations
      link.classList.add("landing");
    };

    link.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") land();
    });
    link.addEventListener("focus", () => {
      keyboardFocus = link.matches(":focus-visible");
    });
    link.addEventListener("blur", () => {
      if (keyboardFocus) land();
    });
  }
</script>
