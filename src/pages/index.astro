---
import Layout from "../layouts/Layout.astro";
import SocialLink from "../components/SocialLink.astro";
import { site } from "../config.js";
---

<Layout>
  <main class="fade-in">
    <h1>{site.name}</h1>
    <p class="role">{site.role}</p>
    <nav class="links fade-in" aria-label="Contact and profiles">
      <SocialLink href={site.links.linkedin} icon="linkedin" label="LinkedIn" />
      <SocialLink href={site.links.github} icon="github" label="GitHub" />
      <SocialLink href={`mailto:${site.links.email}`} icon="email" label="Email" />
    </nav>
  </main>
</Layout>

<style>
  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: calc(10px + 2vmin);
  }

  .role {
    font-weight: bold;
    margin: 1.33em 0;
  }

  .links {
    display: flex;
    column-gap: 1rem;
    padding: 10px;
  }
</style>
